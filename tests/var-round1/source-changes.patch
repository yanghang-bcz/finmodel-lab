+body.risk-workbench #riskChartTitle{font:500 14px/1.6 var(--font-ui);margin:0 0 4px;flex:none}
+body.risk-workbench .risk-svg{position:relative;flex:1;min-height:285px}
+body.risk-workbench .risk-svg svg{position:absolute;inset:0;width:100%;height:100%}
+body.risk-workbench .risk-svg text{font:14px var(--font-ui);fill:#607580}
+body.risk-workbench [data-risk-tip]{cursor:pointer;outline:none}
+body.risk-workbench [data-risk-tip]:focus{stroke:#8c80a3;stroke-width:3}
+body.risk-workbench #riskTip[data-state=preview]{pointer-events:none}
+body.risk-workbench #riskCloseTip{float:right;font-size:16px;padding:0 4px;margin-left:5px}
+body.risk-workbench #riskInsight{font-size:13px;line-height:1.8;margin:7px 0}
+body.risk-workbench #details p{font-size:12px;line-height:1.8}
+body.risk-workbench #riskTiming,body.risk-workbench #riskTail,body.risk-workbench .risk-note{color:#607580}
+body.risk-workbench #inputs label,body.risk-workbench #riskAdvanced label{display:grid;grid-template-columns:minmax(0,1fr) minmax(80px,42%);align-items:center;gap:8px;margin:9px 0;font-size:13px}
+body.risk-workbench #riskAdvanced input{width:100%;min-width:0;padding:7px;height:36px}
+body.risk-workbench #riskAdvanced,body.risk-workbench #riskExplore{font-size:12px;line-height:1.8;margin:10px 0;border-top:1px solid var(--border);padding-top:10px}
+body.risk-workbench #riskLambdaChoices p{font-size:12px;line-height:1.8;color:#607580}
+body.risk-workbench #riskLambdaChoices button,body.risk-workbench #riskExplore button{font-size:12px;padding:5px;margin:3px}
+body.risk-workbench #riskExplore h3{font-size:14px}
+body.risk-workbench #riskMethodSelect{min-width:0;width:100%;font:12px var(--font-ui);padding:7px}
+body.risk-workbench #riskFormula{overflow:auto;margin-top:8px;font-size:16px}
+body.risk-workbench.projector .risk-svg text{font-size:17px}
+body.risk-workbench.projector #riskQuestion{font-size:17px}
+body.risk-workbench.projector #riskInsight{font-size:15px}
+@media(max-width:980px){body.risk-workbench .model-panel{height:1000px}body.risk-workbench #chartHost{height:400px}}
+
+body.risk-workbench #legend .risk-es-symbol{width:8px;height:8px;background:var(--legend-color);border:0;transform:rotate(45deg);margin-inline:5px}
+/* At real 125% zoom, keep the complete chart axes inside the short panel. */
+@media(min-width:981px) and (max-height:650px){body.risk-workbench #chartHost{height:275px;min-height:275px}body.risk-workbench .risk-svg{min-height:245px}}
