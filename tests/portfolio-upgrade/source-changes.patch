+# 1. 当前参数与可复现数据
+${input}
+asset_names <- ${JSON.stringify(names).replace(/^\[/,'c(').replace(/\]$/,')')}
+w <- ${vector(w)}
+lambda <- ${model.lambda}
+# 主动选择岭正则时加 lambda*I，优化目标随之改变
+Sigma <- Sigma_raw + diag(lambda, length(mu))
+stopifnot(length(mu) >= 2, length(mu) <= 5,
+          all(w >= 0), abs(sum(w)-1) < 1e-8,
