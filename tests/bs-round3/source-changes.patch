+S0 <- ${p.S}; K <- ${p.K}; T <- ${p.T}; r <- ${p.r}; q <- ${p.q}; sigma <- ${p.sigma}
+N <- ${p.N}; interval <- ${p.interval}; seed <- ${p.seed}; type <- "${p.type}"
